# Copy this file to .env and fill in real values. .env is never committed.
# Only the three LLM_ settings are required; everything else has a tested default.

# ---- LLM: any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, a local Ollama, ...) ----
# Local Ollama:      LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama
# Ollama + Docker:   LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# LLM_TIMEOUT=60        # seconds before a call is abandoned (then retried twice, then a 503)
# LLM_MAX_TOKENS=0      # cap the answer length; 0 = no cap. Careful with reasoning models: they need room to think

# ---- API ----
# API_KEY=              # set it to require an X-API-Key header on /ask, /ask/stream and /search
# LOG_LEVEL=INFO

# ---- Storage ----
# DATA_DIR=data         # your .txt files
# CHROMA_DIR=storage/chroma
# empty = no exact cache (Docker Compose sets this for you)
REDIS_URL=redis://localhost:6379/0

# ---- Caches ----
# CACHE_TTL_SECONDS=86400
# SEMANTIC_CACHE_THRESHOLD=0.85      # 0 = semantic cache off

# ---- Models and retrieval (change a model -> rebuild the index: uv run advanced-rag build) ----
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# RERANK_CANDIDATES=20  # measured sweet spot; more costs time with no quality gain here
# MIN_SIMILARITY=0.3
# MIN_RERANK_SCORE=0.0
