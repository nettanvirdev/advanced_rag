# Copy this file to .env and fill in real values. .env is never committed.

# ---- LLM (first used in the "Simple RAG" section) ----
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, Groq, a local Ollama, ...
# The base URL already contains the host, e.g. local Ollama:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---- Embeddings (local first, API swap at the end) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Storage ----
CHROMA_DIR=storage/chroma
REDIS_URL=redis://localhost:6379/0
